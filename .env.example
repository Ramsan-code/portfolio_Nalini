# Copy to .env.local and fill in.

# Web3Forms access key (free at https://web3forms.com). Without it the contact
# form validates but shows a "not configured" message with a mailto link.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Deployed origin, no trailing slash. Used for canonical URL, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# Only for GitHub Pages project sites, e.g. /portfolio_Nalini. Leave empty otherwise.
NEXT_PUBLIC_BASE_PATH=

# Set to true to preview draft/TODO content in a production build.
NEXT_PUBLIC_SHOW_DRAFTS=
